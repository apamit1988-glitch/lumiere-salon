    }

    .gallery-item:nth-child(3) {
        transition-delay: 0.2s;
    }

    .gallery-item:nth-child(4) {
        transition-delay: 0.3s;
    }

    @media (prefers-reduced-motion: reduce) {
        :global(html) {
            scroll-behavior: auto;
