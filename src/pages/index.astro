    nav a {
        position: relative;
    }

    nav a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -6px;
        width: 100%;
        height: 1px;
        background: var(--color-accent);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.3s ease;
    }

    nav a.active::after {
        transform: scaleX(1);
        transform-origin: left;
    }

    nav a:hover::after {
        transform: scaleX(1);
        transform-origin: left;
    }

