---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{site.title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta
        name="description"
        content={site.description}
    />

    <meta property="og:title" content={site.title} />

    <meta
        property="og:description"
        content={site.description}
    />

    <meta
        property="og:image"
        content="https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=1200&q=85"
    />

    <meta property="og:type" content="website" />

    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f7f3ee" />

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    />
    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    />
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet"
    />
  </head>

  <body>
    <header class="navbar">
        <a href="#hero" class="logo">{site.name}</a>

        <nav>
            <a href="#services">Services</a>
            <a href="#service-finder">Find Your Service</a>
            <a href="#service-builder">Package Builder</a>
            <a href="#about">About</a>
            <a href="#gallery">Our Work</a>
            <a href="#contact">Contact</a>
            <a href="#faq">FAQ</a>
        </nav>

        <a href="#contact" class="nav-button">Book</a>

        <button
            type="button"
            class="menu-toggle"
            aria-label="Open menu"
            aria-expanded="false"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>

        <div class="mobile-menu" id="mobile-menu">
            <a href="#services">Services</a>
            <a href="#service-finder">Find Your Service</a>
            <a href="#service-builder">Package Builder</a>
            <a href="#about">About</a>
            <a href="#gallery">Our Work</a>
            <a href="#faq">FAQ</a>
            <a href="#contact" class="mobile-book">Book an appointment</a>
        </div>
    </header>
    <main>
        <section class="hero" id="hero">
            <div class="hero-content">
            <p class="eyebrow">BEAUTY STUDIO · {site.city.toUpperCase()}</p>

            <h1>
                {site.heroTitle}<br />
                <em>{site.heroTitleEmphasis}</em>
            </h1>

            <p class="hero-description">
                {site.tagline}
            </p>

            <a href="#contact" class="hero-button">
                Book an appointment
            </a>
            </div>

            <div class="hero-image">
                <img
                    src="https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=1200&q=85"
                    alt="Luxury beauty salon"
                    fetchpriority="high"
                />
            </div>
        </section>
        <section class="services" id="services">
            <div class="section-heading reveal">
                <p class="eyebrow">OUR SERVICES</p>
                <h2>Beauty rituals,<br /><em>beautifully refined.</em></h2>
            </div>

            <div class="service-grid">
                {serviceCategories.map((category, index) => {
                    const categoryServices = services.filter(
                    (service) => service.category === category.category
                    );

                    return (
                    <article class="service-category-card reveal">
                        <span class="service-number">
                        {String(index + 1).padStart(2, "0")}
                        </span>

                        <h3>{category.name}</h3>

                        <p>{category.description}</p>

                        <div class="service-category-list">
                        {categoryServices.map((service) => (
                            <details class="service-menu-item">
                                <summary>
                                    <span class="service-menu-name">{service.name}</span>
                                    <span class="service-menu-price">{service.price}</span>
                                </summary>

                                <p class="service-menu-description">{service.description}</p>
                            </details>
                        ))}
                    </div>
                    </article>
                    );
                })}
            </div>
        </section>
        <section
            class="service-finder"
            id="service-finder"
            data-whatsapp={site.whatsapp}
            data-site-name={site.name}
            data-phone={site.phone}
        >
            <div class="service-finder-content">
                <p class="eyebrow">FIND YOUR SERVICE</p>

                <h2>
                Not sure where<br />
                <em>to begin?</em>
                </h2>

                <p>
                Tell us what you're looking for and we'll help you find the right
                beauty experience.
                </p>

                <div class="service-finder-options">
                    <button type="button" data-category="hair">Hair</button>
                    <button type="button" data-category="skin">Skin</button>
                    <button type="button" data-category="bridal">Bridal</button>
                    <button type="button" data-category="nails">Nails</button>
                </div>

                <div class="service-finder-goals" id="service-finder-goals" hidden>
                    <p class="finder-question">What's your goal?</p>

                    <div class="service-finder-options">
                        <button type="button" data-goal="refresh">
                        Refresh my look
                        </button>

                        <button type="button" data-goal="occasion">
                        Special occasion
                        </button>

                        <button type="button" data-goal="selfcare">
                        Self-care
                        </button>
                    </div>
                </div>
            </div>

            <div
                class="service-finder-results"
                id="service-finder-results"
                data-services={JSON.stringify(services)}
            ></div>
        </section>
        <section class="service-builder" id="service-builder">
            <div class="section-heading reveal">
                <p class="eyebrow">CREATE YOUR EXPERIENCE</p>
                <h2>Build your beauty<br /><em>package.</em></h2>
                <p>{serviceBuilder.description}</p>
            </div>

            <div class="service-builder-content">
                <div class="service-builder-services">
                    {serviceCategories.map((category, index) => {
                        const categoryServices = services.filter(
                        (service) => service.category === category.category
                        );

                        return (
                        <div class="service-builder-category">
                            <button
                            type="button"
                            class="service-builder-category-toggle"
                            aria-expanded="false"
                            >
                            <span>
                                <small>{String(index + 1).padStart(2, "0")}</small>
                                {category.name}
                            </span>

                            <strong>+</strong>
                            </button>

                            <div class="service-builder-category-content" hidden>
                            {categoryServices.map((service) => (
                                <label class="service-builder-option">
                                <input
                                    type="checkbox"
                                    value={service.number}
                                    data-service-name={service.name}
                                    data-service-price={service.price}
                                />

                                <span class="service-builder-option-content">
                                    <span class="service-builder-check"></span>

                                    <span class="service-builder-option-name">
                                        {service.name}
                                    </span>

                                    <strong>{service.price}</strong>
                                </span>
                                </label>
                            ))}
                            </div>
                        </div>
                        );
                    })}
                </div>

                <div class="service-builder-summary">
                    <span>YOUR PACKAGE</span>

                    <div id="service-builder-selected">
                        No services selected yet.
                    </div>

                    <strong id="service-builder-total">₹0</strong>

                    <div class="service-builder-actions">
                        <button type="button" id="service-builder-whatsapp" class="finder-whatsapp">
                            Enquire on WhatsApp
                        </button>

                        <a href={`tel:${site.phone}`} class="finder-call">
                            Call for Enquiry
                        </a>
                    </div>
                </div>
            </div>
        </section>
        <section class="about" id="about">
            <div class="about-image reveal">
                <img
                    src={site.aboutImage.src}
                    alt={site.aboutImage.alt}
                    loading="lazy"
                    decoding="async"
                />
            </div>

            <div class="about-content reveal">
                <p class="eyebrow">{site.aboutEyebrow}</p>

                <h2>
                    {site.aboutTitle}<br />
                    <em>{site.aboutTitleEmphasis}</em>
                </h2>

                <p>
                    {site.aboutDescription}
                </p>

                <div class="about-details">
                <div>
                    <strong>{site.stats.years}</strong>
                    <span>Years of artistry</span>
                </div>

                <div>
                    <strong>{site.stats.clients}</strong>
                    <span>Happy clients</span>
                </div>

                <div>
                    <strong>{site.stats.rating}</strong>
                    <span>Client rating</span>
                </div>
                </div>
            </div>
        </section>
        <section class="gallery" id="gallery">
            <div class="gallery-heading reveal">
                <p class="eyebrow">OUR WORK</p>
                <h2>A glimpse of<br /><em>the experience.</em></h2>
            </div>

            <div class="gallery-grid">
                {gallery.map((item) => (
                    <article class:list={["gallery-item", item.className, "reveal"]}>
                    <div class="transformation-card">
                        <div class="before-after-slider">
                            <div class="before-after-after">
                                <img
                                src={item.afterImage}
                                alt={item.afterAlt}
                                loading="lazy"
                                decoding="async"
                                />
                                <span class="transformation-label">AFTER</span>
                            </div>

                            <div class="before-after-before">
                                <img
                                src={item.beforeImage}
                                alt={item.beforeAlt}
                                loading="lazy"
                                decoding="async"
                                />
                                <span class="transformation-label">BEFORE</span>
                            </div>

                            <div class="before-after-divider">
                                <span>↔</span>
                            </div>
                        </div>

                        <div class="gallery-label">
                            <span>{item.number}</span>

                            <div>
                            <strong>{item.label}</strong>
                            <small>{item.service}</small>
                            </div>
                        </div>
                    </div>
                    </article>
                ))}
            </div>
        </section>
        <section class="contact" id="contact">
            <div class="contact-content reveal">
                <p class="eyebrow">BOOK YOUR VISIT</p>

                <h2>
                Your beauty,<br />
                <em>your moment.</em>
                </h2>

                <p class="contact-description">
                Ready for a little time for yourself? Get in touch with us
                and we'll help you find the perfect appointment.
                </p>

                <p class="contact-note">
                    Your appointment will be confirmed once our team checks availability
                    and gets back to you on WhatsApp.
                </p>

                <form
                    class="appointment-form"
                    id="appointment-form"
                    data-whatsapp={site.whatsapp}
                    data-salon-name={site.name}
                >

                    <div class="appointment-field">
                        <label for="service-picker-trigger">What would you like?</label>

                        <div class="custom-service-picker" id="custom-service-picker">
                            <button
                                type="button"
                                class="service-picker-trigger"
                                id="service-picker-trigger"
                                aria-haspopup="listbox"
                                aria-expanded="false"
                            >
                                <span id="selected-service-label">Select a service</span>
                                <span class="service-picker-arrow" aria-hidden="true">⌄</span>
                            </button>

                            <div
                                class="service-picker-options"
                                id="service-picker-options"
                                role="listbox"
                                aria-label="Available services"
                                hidden
                            >
                                <button type="button" class="service-picker-option" role="option" data-value="Hair">Hair</button>
                                <button type="button" class="service-picker-option" role="option" data-value="Skin">Skin</button>
                                <button type="button" class="service-picker-option" role="option" data-value="Bridal">Bridal</button>
                                <button type="button" class="service-picker-option" role="option" data-value="Nails">Nails</button>
                                <button type="button" class="service-picker-option" role="option" data-value="Other">Other</button>
                            </div>

                            <input type="hidden" id="appointment-service" name="service" />
                        </div>
                    </div>

                   <div class="appointment-field">
                        <label for="date-picker-trigger">Preferred date</label>

                        <div class="custom-date-picker" id="custom-date-picker">
                            <button
                                type="button"
                                class="date-picker-trigger"
                                id="date-picker-trigger"
                                aria-haspopup="dialog"
                                aria-expanded="false"
                            >
                                <span id="selected-date-label">Select a date</span>
                                <span class="date-picker-arrow" aria-hidden="true">⌄</span>
                            </button>

                            <div
                                class="date-picker-calendar"
                                id="date-picker-calendar"
                                role="dialog"
                                aria-label="Choose an appointment date"
                                hidden
                            >
                                <div class="calendar-header">
                                    <button
                                        type="button"
                                        class="calendar-nav"
                                        id="calendar-prev"
                                        aria-label="Previous month"
                                    >
                                        ‹
                                    </button>

                                    <span id="calendar-month-year"></span>

                                    <button
                                        type="button"
                                        class="calendar-nav"
                                        id="calendar-next"
                                        aria-label="Next month"
                                    >
                                        ›
                                    </button>
                                </div>

                                <div class="calendar-weekdays" aria-hidden="true">
                                    <span>Su</span>
                                    <span>Mo</span>
                                    <span>Tu</span>
                                    <span>We</span>
                                    <span>Th</span>
                                    <span>Fr</span>
                                    <span>Sa</span>
                                </div>

                                <div
                                    class="calendar-days"
                                    id="calendar-days"
                                    role="group"
                                    aria-label="Calendar dates"
                                ></div>
                            </div>

                            <input
                                type="hidden"
                                id="appointment-date"
                                name="date"
                                required
                            />
                        </div>
                    </div>

                    <div class="appointment-field">
                        <label for="time-picker-trigger">Preferred time</label>

                        <div class="custom-time-picker" id="custom-time-picker">
                            <button
                                type="button"
                                class="time-picker-trigger"
                                id="time-picker-trigger"
                                aria-haspopup="listbox"
                                aria-expanded="false"
                            >
                                <span id="selected-time-label">Select your preferred time</span>
                                <span class="time-picker-arrow" aria-hidden="true">⌄</span>
                            </button>

                            <div
                                class="time-picker-options"
                                id="time-picker-options"
                                role="listbox"
                                aria-label="Available appointment times"
                                hidden
                            ></div>

                            <input
                                type="hidden"
                                id="appointment-time"
                                name="time"
                            />
                        </div>
                    </div>

                    <div class="appointment-field">
                        <label for="appointment-name">Your name</label>
                        <input
                            type="text"
                            id="appointment-name"
                            name="name"
                            placeholder="Enter your name"
                            required
                        />
                    </div>

                    <div class="appointment-field">
                        <label for="appointment-details">Additional details (optional)</label>
                        <textarea
                            id="appointment-details"
                            name="details"
                            rows="3"
                            placeholder="Tell us a little about what you're looking for..."
                        ></textarea>
                    </div>

                    <button type="submit" class="contact-button">
                        Continue on WhatsApp
                    </button>

                </form>
                <script>
                    const appointmentForm = document.querySelector<HTMLFormElement>(
                        "#appointment-form"
                    );

                    const appointmentDateInput = document.querySelector<HTMLInputElement>(
                        "#appointment-date"
                    );

                    if (appointmentDateInput) {
                        const today = new Date();

                        const year = today.getFullYear();
                        const month = String(today.getMonth() + 1).padStart(2, "0");
                        const day = String(today.getDate()).padStart(2, "0");

                        appointmentDateInput.min = `${year}-${month}-${day}`;
                    }
                    const dateInput = appointmentForm?.querySelector<HTMLInputElement>(
                        "#appointment-date"
                    );

                    const timeInput = appointmentForm?.querySelector<HTMLInputElement>(
                        "#appointment-time"
                    );

                    [dateInput, timeInput].forEach((input) => {
                        input?.addEventListener("click", () => {
                            if (typeof input.showPicker === "function") {
                                try {
                                    input.showPicker();
                                } catch {
                                    // The browser may prevent opening the native picker.
                                }
                            }
                        });
                    });

                    const servicePicker = document.querySelector<HTMLDivElement>(
                        "#custom-service-picker"
                    );

                    const servicePickerTrigger = document.querySelector<HTMLButtonElement>(
                        "#service-picker-trigger"
                    );

                    const servicePickerOptions = document.querySelector<HTMLDivElement>(
                        "#service-picker-options"
                    );

                    const selectedServiceLabel = document.querySelector<HTMLSpanElement>(
                        "#selected-service-label"
                    );

                    const appointmentServiceInput = document.querySelector<HTMLInputElement>(
                        "#appointment-service"
                    );

                    if (
                        servicePicker &&
                        servicePickerTrigger &&
                        servicePickerOptions &&
                        selectedServiceLabel &&
                        appointmentServiceInput
                    ) {
                        const serviceOptions =
                            servicePickerOptions.querySelectorAll<HTMLButtonElement>(
                                ".service-picker-option"
                            );

                        serviceOptions.forEach((option) => {
                            option.addEventListener("click", () => {
                                const value = option.dataset.value;

                                if (!value) return;

                                appointmentServiceInput.value = value;
                                selectedServiceLabel.textContent = value;

                                serviceOptions.forEach((item) => {
                                    item.setAttribute("aria-selected", "false");
                                });

                                option.setAttribute("aria-selected", "true");

                                servicePickerOptions.hidden = true;
                                servicePickerTrigger.setAttribute("aria-expanded", "false");
                            });
                        });

                        servicePickerTrigger.addEventListener("click", () => {
                            const isOpen = !servicePickerOptions.hidden;

                            servicePickerOptions.hidden = isOpen;
                            servicePickerTrigger.setAttribute("aria-expanded", String(!isOpen));
                        });

                        document.addEventListener("click", (event) => {
                            if (!servicePicker.contains(event.target as Node)) {
                                servicePickerOptions.hidden = true;
                                servicePickerTrigger.setAttribute("aria-expanded", "false");
                            }
                        });

                        servicePicker.addEventListener("keydown", (event) => {
                            if (event.key === "Escape") {
                                servicePickerOptions.hidden = true;
                                servicePickerTrigger.setAttribute("aria-expanded", "false");
                                servicePickerTrigger.focus();
                            }
                        });
                    }

                    const timePicker = document.querySelector<HTMLDivElement>(
                        "#custom-time-picker"
                    );

                    const timePickerTrigger = document.querySelector<HTMLButtonElement>(
                        "#time-picker-trigger"
                    );

                    const timePickerOptions = document.querySelector<HTMLDivElement>(
                        "#time-picker-options"
                    );

                    const selectedTimeLabel = document.querySelector<HTMLSpanElement>(
                        "#selected-time-label"
                    );

                    const appointmentTimeInput = document.querySelector<HTMLInputElement>(
                        "#appointment-time"
                    );

                    if (
                        timePicker &&
                        timePickerTrigger &&
                        timePickerOptions &&
                        selectedTimeLabel &&
                        appointmentTimeInput
                    ) {
                        // Generate sample appointment times: 10:00 AM to 7:30 PM.
                        for (let minutes = 10 * 60; minutes <= 19 * 60 + 30; minutes += 30) {
                            const hours24 = Math.floor(minutes / 60);
                            const mins = minutes % 60;

                            const period = hours24 >= 12 ? "PM" : "AM";
                            const hours12 = hours24 % 12 || 12;
                            const formattedMinutes = String(mins).padStart(2, "0");

                            const displayTime = `${hours12}:${formattedMinutes} ${period}`;
                            const valueTime = `${String(hours24).padStart(2, "0")}:${formattedMinutes}`;

                            const option = document.createElement("button");

                            option.type = "button";
                            option.className = "time-picker-option";
                            option.textContent = displayTime;
                            option.setAttribute("role", "option");
                            option.setAttribute("aria-selected", "false");

                            option.addEventListener("click", () => {
                                appointmentTimeInput.value = valueTime;
                                selectedTimeLabel.textContent = displayTime;

                                timePickerOptions
                                    .querySelectorAll(".time-picker-option")
                                    .forEach((item) => {
                                        item.setAttribute("aria-selected", "false");
                                    });

                                option.setAttribute("aria-selected", "true");

                                timePickerOptions.hidden = true;
                                timePickerTrigger.setAttribute("aria-expanded", "false");
                            });

                            timePickerOptions.appendChild(option);
                        }

                        // Open or close the dropdown when the trigger is clicked.
                        timePickerTrigger.addEventListener("click", () => {
                            const isOpen = !timePickerOptions.hidden;

                            timePickerOptions.hidden = isOpen;
                            timePickerTrigger.setAttribute("aria-expanded", String(!isOpen));
                        });

                        // Close the dropdown when clicking outside the picker.
                        document.addEventListener("click", (event) => {
                            if (!timePicker.contains(event.target as Node)) {
                                timePickerOptions.hidden = true;
                                timePickerTrigger.setAttribute("aria-expanded", "false");
                            }
                        });

                        // Close the dropdown when Escape is pressed.
                        timePicker.addEventListener("keydown", (event) => {
                            if (event.key === "Escape") {
                                timePickerOptions.hidden = true;
                                timePickerTrigger.setAttribute("aria-expanded", "false");
                                timePickerTrigger.focus();
                            }
                        });
                    }

                    appointmentForm?.addEventListener("submit", (event) => {
                        event.preventDefault();

                        if (!appointmentForm.reportValidity()) {
                            return;
                        }

                        if (!appointmentServiceInput?.value) {
                            servicePickerTrigger?.focus();
                            servicePickerOptions?.removeAttribute("hidden");
                            servicePickerTrigger?.setAttribute("aria-expanded", "true");
                            selectedServiceLabel!.textContent = "Please select a service";
                            return;
                        }

                        if (!appointmentTimeInput?.value) {
                            timePickerTrigger?.focus();
                            timePickerOptions?.removeAttribute("hidden");
                            timePickerTrigger?.setAttribute("aria-expanded", "true");
                            selectedTimeLabel!.textContent = "Please select a time";
                            return;
                        }

                        const formData = new FormData(appointmentForm);

                        const service = formData.get("service");
                        const date = formData.get("date");
                        const time = formData.get("time");
                        const name = formData.get("name");
                        const details = formData.get("details");

                        const whatsapp = appointmentForm.dataset.whatsapp;
                        const salonName = appointmentForm.dataset.salonName;

                        if (!whatsapp) {
                            console.error("WhatsApp number is missing.");
                            return;
                        }

                        const message = [
                            `Hi ${salonName},`,
                            "",
                            "I found your salon through your website and would like to enquire about an appointment.",
                            "",
                            `Name: ${name}`,
                            `Service: ${service}`,
                            `Preferred date: ${date}`,
                            `Preferred time: ${time}`,
                            "",
                            ...(details.trim()
                                ? ["Additional details:", details.trim(), ""]
                                : []),
                            "Please let me know if this time is available.",
                            "",
                            "Thank you!"
                        ].join("\n");

                        window.open(
                            `https://wa.me/${whatsapp}?text=${encodeURIComponent(message)}`,
                            "_blank",
                            "noopener,noreferrer"
                        );
                    });

                    // ========================================
                    // Lumière — Custom Date Picker
                    // ========================================

                    const customDatePicker = document.querySelector<HTMLDivElement>(
                        "#custom-date-picker"
                    );
                    const datePickerTrigger = document.querySelector<HTMLButtonElement>(
                        "#date-picker-trigger"
                    );
                    const datePickerCalendar = document.querySelector<HTMLDivElement>(
                        "#date-picker-calendar"
                    );
                    const selectedDateLabel = document.querySelector<HTMLSpanElement>(
                        "#selected-date-label"
                    );
                    const calendarMonthYear = document.querySelector<HTMLSpanElement>(
                        "#calendar-month-year"
                    );
                    const calendarDays = document.querySelector<HTMLDivElement>(
                        "#calendar-days"
                    );
                    const calendarPrev = document.querySelector<HTMLButtonElement>(
                        "#calendar-prev"
                    );
                    const calendarNext = document.querySelector<HTMLButtonElement>(
                        "#calendar-next"
                    );

                    const today = new Date();
                    today.setHours(0, 0, 0, 0);

                    let displayedMonth = new Date(today.getFullYear(), today.getMonth(), 1);

                    const formatDateValue = (date: Date): string => {
                        const year = date.getFullYear();
                        const month = String(date.getMonth() + 1).padStart(2, "0");
                        const day = String(date.getDate()).padStart(2, "0");

                        return `${year}-${month}-${day}`;
                    };

                    const formatDateLabel = (date: Date): string =>
                        date.toLocaleDateString("en-IN", {
                            day: "numeric",
                            month: "long",
                            year: "numeric",
                        });

                    const renderCalendar = (): void => {
                        if (!calendarDays || !calendarMonthYear || !calendarPrev) return;

                        calendarMonthYear.textContent = displayedMonth.toLocaleDateString(
                            "en-IN",
                            {
                                month: "long",
                                year: "numeric",
                            }
                        );

                        calendarDays.replaceChildren();

                        const year = displayedMonth.getFullYear();
                        const month = displayedMonth.getMonth();
                        const firstDayOfWeek = new Date(year, month, 1).getDay();
                        const daysInMonth = new Date(year, month + 1, 0).getDate();

                        // Add blank cells before the first day of the month.
                        for (let i = 0; i < firstDayOfWeek; i++) {
                            const blank = document.createElement("span");
                            blank.className = "calendar-empty";
                            blank.setAttribute("aria-hidden", "true");
                            calendarDays.appendChild(blank);
                        }

                        const selectedValue = appointmentDateInput?.value;

                        for (let day = 1; day <= daysInMonth; day++) {
                            const date = new Date(year, month, day);
                            date.setHours(0, 0, 0, 0);

                            const dateValue = formatDateValue(date);
                            const isPastDate = date < today;

                            const dayButton = document.createElement("button");
                            dayButton.type = "button";
                            dayButton.className = "calendar-day";
                            dayButton.textContent = String(day);
                            dayButton.disabled = isPastDate;
                            dayButton.setAttribute("aria-label", formatDateLabel(date));

                            if (dateValue === selectedValue) {
                                dayButton.classList.add("is-selected");
                                dayButton.setAttribute("aria-pressed", "true");
                            } else {
                                dayButton.setAttribute("aria-pressed", "false");
                            }

                            if (dateValue === formatDateValue(today)) {
                                dayButton.classList.add("is-today");
                            }

                            dayButton.addEventListener("click", () => {
                                if (!appointmentDateInput || !selectedDateLabel) return;

                                appointmentDateInput.value = dateValue;
                                selectedDateLabel.textContent = formatDateLabel(date);

                                datePickerTrigger?.setAttribute("aria-expanded", "false");
                                datePickerCalendar?.setAttribute("hidden", "");
                                renderCalendar();
                            });

                            calendarDays.appendChild(dayButton);
                        }

                        // Prevent navigating to months entirely before the current month.
                        const currentMonth = new Date(today.getFullYear(), today.getMonth(), 1);
                        calendarPrev.disabled = displayedMonth <= currentMonth;
                    };

                    const openDatePicker = (): void => {
                        if (!datePickerCalendar || !datePickerTrigger) return;

                        // Open on the currently selected month, or the current month.
                        if (appointmentDateInput?.value) {
                            const [year, month] = appointmentDateInput.value.split("-").map(Number);
                            displayedMonth = new Date(year, month - 1, 1);
                        } else {
                            displayedMonth = new Date(today.getFullYear(), today.getMonth(), 1);
                        }

                        renderCalendar();
                        datePickerCalendar.removeAttribute("hidden");
                        datePickerTrigger.setAttribute("aria-expanded", "true");
                    };

                    datePickerTrigger?.addEventListener("click", () => {
                        const isOpen = datePickerTrigger.getAttribute("aria-expanded") === "true";

                        if (isOpen) {
                            datePickerCalendar?.setAttribute("hidden", "");
                            datePickerTrigger.setAttribute("aria-expanded", "false");
                        } else {
                            openDatePicker();
                        }
                    });

                    calendarPrev?.addEventListener("click", () => {
                        displayedMonth = new Date(
                            displayedMonth.getFullYear(),
                            displayedMonth.getMonth() - 1,
                            1
                        );
                        renderCalendar();
                    });

                    calendarNext?.addEventListener("click", () => {
                        displayedMonth = new Date(
                            displayedMonth.getFullYear(),
                            displayedMonth.getMonth() + 1,
                            1
                        );
                        renderCalendar();
                    });

                    document.addEventListener("click", (event) => {
                        if (
                            customDatePicker &&
                            event.target instanceof Node &&
                            !customDatePicker.contains(event.target)
                        ) {
                            datePickerCalendar?.setAttribute("hidden", "");
                            datePickerTrigger?.setAttribute("aria-expanded", "false");
                        }
                    });

                    document.addEventListener("keydown", (event) => {
                        if (event.key === "Escape") {
                            datePickerCalendar?.setAttribute("hidden", "");
                            datePickerTrigger?.setAttribute("aria-expanded", "false");
                            datePickerTrigger?.focus();
                        }
                    });

                    // Initial calendar render.
                    renderCalendar();
                </script>
            </div>
        </section>
         <!-- FAQ Section -->
        <section class="faq-section" id="faq">
            <div class="faq-container">
                <div class="faq-heading reveal">
                    <span class="section-eyebrow">GOOD TO KNOW</span>
                    <h2>Frequently Asked Questions</h2>
                    <p>
                        Everything you need to know before your visit to Lumière.
                    </p>
                </div>

                <div class="faq-list">
                    <div class="faq-item reveal">
                        <button
                            class="faq-question"
                            type="button"
                            aria-expanded="false"
                        >
                            <span>Do I need to book an appointment in advance?</span>
                            <span class="faq-icon" aria-hidden="true">+</span>
                        </button>
                        <div class="faq-answer" hidden>
                            <p>
                                We recommend booking in advance to help you get your
                                preferred date and time. You can send us an enquiry
                                through our appointment form, and our team will
                                confirm availability.
                            </p>
                        </div>
                    </div>

                    <div class="faq-item reveal">
                        <button
                            class="faq-question"
                            type="button"
                            aria-expanded="false"
                        >
                            <span>How do I know which service is right for me?</span>
                            <span class="faq-icon" aria-hidden="true">+</span>
                        </button>
                        <div class="faq-answer" hidden>
                            <p>
                                You can use our <a href="#service-finder" class="faq-link">Find Your Service</a> feature to explore options based on your needs. If you're unsure,
                                contact us and we'll help you choose a suitable service.
                            </p>
                        </div>
                    </div>

                    <div class="faq-item reveal">
                        <button
                            class="faq-question"
                            type="button"
                            aria-expanded="false"
                        >
                            <span>Can I enquire about multiple services together?</span>
                            <span class="faq-icon" aria-hidden="true">+</span>
                        </button>
                        <div class="faq-answer" hidden>
                            <p>
                                Yes. Use the <a href="#service-builder" class="faq-link">Service Builder</a> to select multiple
                                services and send your enquiry to us through WhatsApp.
                            </p>
                        </div>
                    </div>

                    <div class="faq-item reveal">
                        <button
                            class="faq-question"
                            type="button"
                            aria-expanded="false"
                        >
                            <span>How can I check the prices of your services?</span>
                            <span class="faq-icon" aria-hidden="true">+</span>
                        </button>
                        <div class="faq-answer" hidden>
                            <p>
                                You can explore the services and prices in our <a href="#services" class="faq-link">Services section</a> and use the <a href="#service-builder" class="faq-link">Service Builder</a> to
                                calculate the total for your selected services.
                            </p>
                        </div>
                    </div>

                    <div class="faq-item reveal">
                        <button
                            class="faq-question"
                            type="button"
                            aria-expanded="false"
                        >
                            <span>How will I know if my appointment is confirmed?</span>
                            <span class="faq-icon" aria-hidden="true">+</span>
                        </button>
                        <div class="faq-answer" hidden>
                            <p>
                                Submitting an enquiry does not automatically confirm
                                an appointment. Our team will respond to your message
                                to confirm availability and appointment details.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <footer class="footer">
        <div class="footer-top">
            <div class="footer-brand">
                <a href="/" class="footer-logo">{site.name}</a>
                <p>{site.tagline}</p>
            </div>

            <div class="footer-column">
                <span>CONTACT</span>
                <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
                <a href={`mailto:${site.email}`}>
                    {site.email}
                </a>
            </div>

            <div class="footer-column">
                <span>VISIT</span>
                <p>{site.address}</p>
            </div>

            <div class="footer-column">
                <span>OPENING HOURS</span>
                <p>{site.openingHours}</p>
            </div>

            <div class="footer-column">
                <span>FOLLOW</span>
                <a href={site.instagram} target="_blank" rel="noopener noreferrer">
                    Instagram
                </a>
            </div>

            <div class="footer-column">
                <span>QUICK LINKS</span>
                <a href="#services">Services</a>
                <a href="#service-finder">Find Your Service</a>
                <a href="#service-builder">Package Builder</a>
                <a href="#gallery">Our Work</a>
                <a href="#faq">FAQ</a>
                <a href="#contact">Book an Appointment</a>
            </div>
        </div>

        <div class="footer-bottom">
            <span>© 2026 {site.name} Beauty Studio</span>
            <span>All rights reserved.</span>
        </div>
    </footer>
  </body>
</html>

<style>
    :root {
        --color-bg: #f7f3ee;
        --color-dark: #211c19;
        --color-text-muted: #766f69;
        --color-accent: #b89b72;
        --color-white: #ffffff;

        --font-heading: "Cormorant Garamond", serif;
        --font-body: "Inter", sans-serif;
        --color-border: rgba(33, 28, 25, 0.15);
        --color-border-light: rgba(33, 28, 25, 0.08);
        --color-dark-soft: rgba(33, 28, 25, 0.08);
    }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-dark);
    font-family: var(--font-body);
  }

  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 6%;
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--color-bg);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }

  .logo {
    color: var(--color-dark);
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 600;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 32px;
  }

  nav a {
    color: var(--color-dark);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .nav-button,
  .hero-button {
    background: var(--color-dark);
    color: var(--color-white);
    padding: 13px 22px;
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero {
    min-height: calc(100vh - 90px);
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: 6%;
    padding: 5% 8%;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    margin-bottom: 24px;
  }

  h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(5rem, 9vw, 9rem);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.04em;
  }

  h1 em {
    font-weight: 400;
  }

  .hero-description {
    max-width: 380px;
    margin: 40px 0 32px;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .hero-image {
    height: 70vh;
    min-height: 500px;
  }

  .hero-image {
    position: relative;
    overflow: hidden;
    }

    .hero-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transform: scale(1.02);
    }

  @media (max-width: 768px) {
    nav {
      display: none;
    }

    .hero {
      grid-template-columns: 1fr;
      padding: 10% 6% 15%;
    }

    .hero-image {
      height: 55vh;
      min-height: 400px;
      margin-bottom: 20px;
    }

    h1 {
      font-size: clamp(4.5rem, 20vw, 7rem);
    }

    .nav-button {
      padding: 10px 16px;
    }
  }

    .menu-toggle,
    .mobile-menu {
        display: none;
    }

    @media (max-width: 768px) {
        .navbar {
            padding: 22px 6%;
        }

        .nav-button {
            display: none;
        }

        .menu-toggle {
            display: flex;
            width: 32px;
            height: 32px;
            padding: 0;
            border: 0;
            background: transparent;
            color: var(--color-dark);
            cursor: pointer;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 5px;
        }

        .menu-toggle span {
            display: block;
            width: 22px;
            height: 1.5px;
            background: var(--color-dark);
            transition:
                transform 0.3s ease,
                opacity 0.2s ease;
        }

        .menu-toggle.open span:nth-child(1) {
            transform: translateY(6.5px) rotate(45deg);
        }

        .menu-toggle.open span:nth-child(2) {
            opacity: 0;
        }

        .menu-toggle.open span:nth-child(3) {
            transform: translateY(-6.5px) rotate(-45deg);
        }

        .mobile-menu {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            z-index: 100;
            display: flex;
            flex-direction: column;
            gap: 0;
            background: var(--color-bg);
            border-top: 1px solid rgba(33, 28, 25, 0.1);
            box-shadow: 0 12px 30px rgba(33, 28, 25, 0.08);

            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition:
                opacity 0.3s ease,
                transform 0.3s ease,
                visibility 0.3s ease;
        }

        .mobile-menu.open {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .mobile-menu a {
            color: var(--color-dark);
            padding: 18px 6%;
            border-bottom: 1px solid var(--color-border-light);
            font-family: var(--font-body);
            font-size: 0.95rem;
            text-decoration: none;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .mobile-menu .mobile-book {
            margin: 16px 6%;
            padding: 14px 20px;
            border: 0;
            background: var(--color-dark);
            color: var(--color-white);
            text-align: center;
        }
    }

    .services {
        padding: 140px 8%;
        background: var(--color-white);
    }

    .section-heading {
        max-width: 700px;
        margin-bottom: 70px;
    }

    .section-heading h2 {
        margin: 0;
        font-family: var(--font-heading);
        font-size: clamp(3.5rem, 7vw, 6rem);
        font-weight: 500;
        line-height: 0.9;
        letter-spacing: -0.03em;
    }

    .section-heading h2 em {
        font-weight: 400;
    }

    .service-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        border-top: 1px solid var(--color-border);
    }

    .service-category-card {
        position: relative;
        padding: 32px;
        background: var(--color-white);
        border: 1px solid rgba(33, 28, 25, 0.08);
        text-align: left;
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
    }

    .service-category-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 18px 40px rgba(33, 28, 25, 0.08);
    }

    .service-category-card .service-number {
        display: block;
        margin-bottom: 28px;
        color: var(--color-accent);
        font-size: 0.8rem;
        letter-spacing: 0.15em;
    }

    .service-category-card h3 {
        margin-bottom: 12px;
        font-family: var(--font-heading);
        font-size: 2rem;
        font-weight: 400;
    }

    .service-category-card > p {
        max-width: 360px;
        margin-bottom: 28px;
        color: var(--color-muted);
        line-height: 1.7;
    }

    .service-category-list {
        display: flex;
        flex-direction: column;
        padding-top: 20px;
        border-top: 1px solid rgba(33, 28, 25, 0.1);
    }

    .service-menu-item {
        border-bottom: 1px solid rgba(33, 28, 25, 0.08);
    }

    .service-menu-item:last-child {
        border-bottom: none;
    }

    .service-menu-item summary {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto 16px;
        align-items: center;
        gap: 16px;
        padding: 14px 0;
        cursor: pointer;
        list-style: none;
    }

    .service-menu-item summary::-webkit-details-marker {
        display: none;
    }

    .service-menu-name {
        color: var(--color-dark);
        font-size: 0.95rem;
