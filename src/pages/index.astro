const gallery = [
    {
        number: "01",
        label: "Hair Transformation",
        service: "Signature Haircut",
        beforeImage: "/images/gallery/hair-before.jpg",
        afterImage: "/images/gallery/hair-after.jpg",
        beforeAlt: "Hair before styling",
        afterAlt: "Hair after styling",
        className: "",
    },
    {
        number: "02",
        label: "Bridal Beauty",
        service: "Bridal Makeup Experience",
        beforeImage: "/images/gallery/bridal-before.jpg",
        afterImage: "/images/gallery/bridal-after.jpg",
        beforeAlt: "Bridal look before makeup",
        afterAlt: "Bridal look after makeup",
