    /* ========================================
    Lumière — Custom Date Picker
    ======================================== */

    #custom-date-picker {
        position: relative;
        width: 100%;
    }

    /* Closed picker control */
    #custom-date-picker .date-picker-trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;

        width: 100%;
        min-height: 56px;
        padding: 0.9rem 1rem;
        box-sizing: border-box;

        border: 1px solid #ded6cc;
        border-radius: 4px;
        background: #fffdfb;
        color: #766f69;

        font-family: inherit;
        font-size: 0.95rem;
        text-align: left;
        cursor: pointer;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            background 0.2s ease;
    }

    #custom-date-picker .date-picker-trigger:hover {
        border-color: #b89b72;
        background: #ffffff;
    }

    #custom-date-picker .date-picker-trigger:focus-visible {
        outline: none;
        border-color: #b89b72;
        box-shadow: 0 0 0 3px rgba(184, 155, 114, 0.13);
    }

    #custom-date-picker .date-picker-arrow {
        color: #b89b72;
        font-size: 1.3rem;
        line-height: 1;
        transition: transform 0.2s ease;
    }

    #custom-date-picker
    .date-picker-trigger[aria-expanded="true"]
    .date-picker-arrow {
        transform: rotate(180deg);
    }

    /* Calendar panel */
    #custom-date-picker .date-picker-calendar {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        z-index: 20;

        width: 100%;
        box-sizing: border-box;
        padding: 1rem;

        border: 1px solid rgba(184, 155, 114, 0.35);
        border-radius: 6px;
        background: #fffdfb;
        box-shadow: 0 12px 30px rgba(33, 28, 25, 0.12);
    }

    #custom-date-picker .date-picker-calendar[hidden] {
        display: none;
    }

    /* Month navigation */
    #custom-date-picker .calendar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 1rem;

        color: #211c19;
        font-family: "Cormorant Garamond", serif;
        font-size: 1.3rem;
        font-weight: 600;
    }

    #custom-date-picker .calendar-nav {
        display: grid;
        place-items: center;

        width: 36px;
        height: 36px;

        border: 1px solid #ded6cc;
        border-radius: 4px;
        background: transparent;
        color: #766f69;

        font-size: 1.5rem;
        line-height: 1;
        cursor: pointer;
    }

    #custom-date-picker .calendar-nav:hover:not(:disabled) {
        border-color: #b89b72;
        background: #f3ece3;
        color: #211c19;
    }

    #custom-date-picker .calendar-nav:disabled {
        opacity: 0.35;
        cursor: not-allowed;
    }

    /* Weekday headings and date grid */
    #custom-date-picker .calendar-weekdays,
    #custom-date-picker .calendar-days {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 4px;
        text-align: center;
    }

    #custom-date-picker .calendar-weekdays {
        margin-bottom: 0.5rem;
        color: #766f69;
        font-size: 0.78rem;
        font-weight: 600;
    }

    #custom-date-picker .calendar-weekdays span {
        padding: 0.4rem 0;
    }

    #custom-date-picker .calendar-empty {
        min-height: 38px;
    }

    /* Individual date buttons */
    #custom-date-picker .calendar-days :global(.calendar-day) {
        display: grid;
        place-items: center;

        width: 100%;
        min-width: 0;
        min-height: 38px;
        padding: 0.35rem 0;

        border: 1px solid transparent;
        border-radius: 4px;
        background: transparent;
        color: #514941;

        font-family: inherit;
        font-size: 0.88rem;
        cursor: pointer;

        transition:
            background 0.15s ease,
            color 0.15s ease,
            border-color 0.15s ease;
    }

    #custom-date-picker
    .calendar-days
    :global(.calendar-day:hover:not(:disabled)) {
        border-color: #b89b72;
        background: #f3ece3;
        color: #211c19;
    }

    #custom-date-picker
    .calendar-days
    :global(.calendar-day.is-today) {
        border-color: #b89b72;
    }

    #custom-date-picker
    .calendar-days
    :global(.calendar-day.is-selected) {
        border-color: #b89b72;
        background: #b89b72;
        color: #ffffff;
    }

    #custom-date-picker
    .calendar-days
    :global(.calendar-day:disabled) {
        color: #c9c1b8;
        cursor: not-allowed;
    }

    #custom-date-picker
    .calendar-days
    :global(.calendar-day:focus-visible) {
        outline: 2px solid #b89b72;
        outline-offset: 2px;
    }

    /* Mobile adjustments */
    @media (max-width: 600px) {
        #custom-date-picker .date-picker-trigger {
            min-height: 54px;
            font-size: 16px;
        }

        #custom-date-picker .date-picker-calendar {
            padding: 0.75rem;
        }

        #custom-date-picker .calendar-days :global(.calendar-day) {
            min-height: 36px;
            font-size: 0.85rem;
        }
    }

    /* ========================================
   Lumière — Smart FAQ Accordion
   ======================================== */

    .faq-section {
        padding: 140px 8%;
        background: #f1ebe3;
    }

    .faq-container {
        max-width: 850px;
        margin: 0 auto;
    }

    .faq-heading {
        margin-bottom: 2.5rem;
    }

    .faq-heading .section-eyebrow {
        display: inline-block;
        margin-bottom: 0.8rem;
        color: #b89b72;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.18em;
    }

    .faq-heading h2 {
        margin: 0 0 0.8rem;
        color: #211c19;
        font-family: "Cormorant Garamond", serif;
        font-size: clamp(2.2rem, 5vw, 3.4rem);
        font-weight: 500;
        line-height: 1.1;
    }

    .faq-heading p {
        margin: 0;
        color: #766f69;
        font-size: 0.98rem;
        line-height: 1.7;
    }

    .faq-list {
        border-top: 1px solid #ded6cc;
    }

    .faq-item {
        border-bottom: 1px solid #ded6cc;
    }

    .faq-question {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;

        width: 100%;
        padding: 1.4rem 0;

        border: 0;
        background: transparent;
        color: #211c19;

        font-family: inherit;
        font-size: 1rem;
        font-weight: 500;
        line-height: 1.5;
        text-align: left;
        cursor: pointer;

        transition: color 0.2s ease;
    }

    .faq-question:hover {
        color: #9d7d51;
    }

    .faq-question:focus-visible {
        outline: 2px solid #b89b72;
        outline-offset: 4px;
    }

    .faq-icon {
        flex: 0 0 30px;
        display: grid;
        place-items: center;

        width: 30px;
        height: 30px;

        border: 1px solid #d8c8b2;
        border-radius: 50%;
        color: #a88a62;

        font-size: 1.25rem;
        font-weight: 400;
        line-height: 1;

        transition:
            transform 0.2s ease,
            background 0.2s ease,
            color 0.2s ease;
    }

    .faq-question[aria-expanded="true"] .faq-icon {
        transform: rotate(45deg);
        background: #b89b72;
        color: #ffffff;
    }

    .faq-answer {
        padding: 0 3rem 1.4rem 0;
    }

    .faq-answer p {
        margin: 0;
        color: #766f69;
        font-size: 0.94rem;
        line-height: 1.8;
    }

    .faq-answer[hidden] {
        display: none;
    }

    @media (max-width: 600px) {
        .faq-section {
            padding: 90px 6%;
        }

        .faq-heading {
            margin-bottom: 1.8rem;
        }

        .faq-question {
            gap: 1rem;
            padding: 1.2rem 0;
            font-size: 0.95rem;
        }

        .faq-answer {
            padding: 0 0 1.2rem;
        }

        .faq-answer p {
            font-size: 0.9rem;
        }
    }

    .faq-link {
        color: #9d7d51;
        text-decoration: underline;
        text-decoration-color: rgba(184, 155, 114, 0.55);
        text-underline-offset: 3px;
        transition:
            color 0.2s ease,
            text-decoration-color 0.2s ease;
    }

    .faq-link:hover {
        color: #211c19;
        text-decoration-color: #211c19;
    }

    .faq-link:focus-visible {
        outline: 2px solid #b89b72;
        outline-offset: 3px;
        border-radius: 2px;
    }
</style>

<script define:vars={{ site }}>
    const menuToggle = document.querySelector(".menu-toggle");
    const mobileMenu = document.querySelector(".mobile-menu");

    menuToggle?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.toggle("open");
    menuToggle?.classList.toggle("open", isOpen);
    menuToggle.setAttribute(
        "aria-label",
        isOpen ? "Close menu" : "Open menu"
    );

    menuToggle.setAttribute(
        "aria-expanded",
        isOpen ? "true" : "false"
    );
    });

    mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
        mobileMenu?.classList.remove("open");
        menuToggle?.classList.remove("open");
        menuToggle?.setAttribute("aria-label", "Open menu");
        menuToggle?.setAttribute("aria-expanded", "false");
    });
    });

    const revealElements = document.querySelectorAll(".reveal");

    const revealObserver = new IntersectionObserver(
    (entries) => {
        entries.forEach((entry) => {
        if (entry.isIntersecting) {
            entry.target.classList.add("visible");
        } else {
            entry.target.classList.remove("visible");
        }
        });
    },
    {
        threshold: 0.15,
    }
    );

    revealElements.forEach((element) => {
        revealObserver.observe(element);
    });

    const navLinks = document.querySelectorAll('nav a[href^="#"]');
    const sections = document.querySelectorAll("main section[id]");

    const navObserver = new IntersectionObserver(
    (entries) => {
        entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        navLinks.forEach((link) => {
            link.classList.toggle(
            "active",
            link.getAttribute("href") === `#${entry.target.id}`
            );
        });
        });
    },
    {
        rootMargin: "-30% 0px -60% 0px",
    }
    );

    sections.forEach((section) => navObserver.observe(section));

    window.addEventListener("scroll", () => {
    if (window.scrollY < 100) {
        navLinks.forEach((link) => link.classList.remove("active"));
    }
    });

    const finder = document.querySelector(".service-finder");
    
    if (finder) {
        const whatsapp = finder.dataset.whatsapp;
        const siteName = finder.dataset.siteName;
        const sitePhone = finder.dataset.phone;
        const buttons = finder.querySelectorAll(
            "[data-category]"
        );

        const goalButtons = finder.querySelectorAll(
            "[data-goal]"
        );

        const goalsContainer = finder.querySelector(
            "#service-finder-goals"
        );

        const results = finder.querySelector("#service-finder-results");

        const serviceData = JSON.parse(
            results.dataset.services || "[]"
        );

        let selectedCategory = "";

        // EXISTING CATEGORY CODE
        buttons.forEach((button) => {
            button.addEventListener("click", () => {
            const category = button.dataset.category;

            selectedCategory = category;

            buttons.forEach((item) => {
                item.classList.toggle("active", item === button);
            });

            goalsContainer.hidden = false;
            goalButtons.forEach((item) => {
                item.classList.remove("active");
            });
            results.innerHTML = "";
            });
        });

        // ADD THE NEW GOAL CODE HERE
        goalButtons.forEach((button) => {
            button.addEventListener("click", () => {
            const goal = button.dataset.goal;

            goalButtons.forEach((item) => {
                item.classList.toggle("active", item === button);
            });

            const matchingServices = serviceData.filter(
                (service) =>
                service.category === selectedCategory &&
                service.goals.includes(goal)
            );

            results.innerHTML = matchingServices
            .map(
                (service) => `
                <article class="finder-result">

                    <span>${service.number}</span>

                    <div>
                    ${
                        service.recommended
                        ? '<small class="finder-recommendation">OUR RECOMMENDATION</small>'
                        : ""
                    }

                    <h3 class="${service.recommended ? "finder-package-name" : ""}">
                        ${service.name}
                    </h3>

                    <p class="finder-match">
                        ${service.matchMessage}
                    </p>

                    <p>${service.description}</p>
                    </div>

                    <div class="finder-result-action">
                        <strong>From ${service.price}</strong>
                        ${(() => {
                            const builderOption = document.querySelector(
                                `.service-builder-option input[value="${service.number}"]`
                            );

                            const isAdded = builderOption?.checked;

                            return `
                                <button
                                    type="button"
                                    class="finder-add-package ${isAdded ? "added" : ""}"
                                    data-service-number="${service.number}"
                                >
                                    ${isAdded ? "✓ ADDED TO MY PACKAGE" : "ADD TO MY PACKAGE"}
                                </button>
                            `;
                        })()}
                        <a
                            href="https://wa.me/${whatsapp}?text=${encodeURIComponent(
                                `Hi ${siteName},\n\nI found your salon through your website and I'm interested in ${service.name}.\n\nCould you please share more details?\n\nThank you!`
                            )}"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="finder-whatsapp"
                        >
                            ENQUIRE ON WHATSAPP
                        </a>

                        <a
                            href="tel:${sitePhone}"
                            class="finder-call"
                        >
                            CALL FOR ENQUIRY
                        </a>
                    </div>
                    </article>
                `
                )
                .join("");
                results.scrollIntoView({
                    behavior: "smooth",
                    block: "center",
                });
            });
        });

        finder.addEventListener("click", (event) => {
            const button = event.target.closest(".finder-add-package");

            if (!button) return;

            const serviceNumber = button.dataset.serviceNumber;

            const builderOption = document.querySelector(
                `.service-builder-option input[value="${serviceNumber}"]`
            );

            if (!builderOption) return;

            // Toggle the service selection
            builderOption.checked = !builderOption.checked;

            // Trigger the existing Package Builder update logic
            builderOption.dispatchEvent(
                new Event("change", { bubbles: true })
            );

            // Update the button label and appearance
            const isAdded = builderOption.checked;

            button.textContent = isAdded
                ? "✓ Added to My Package"
                : "ADD TO MY PACKAGE";

            button.classList.toggle("added", isAdded);

            // Keep the existing behavior of scrolling to the Package Builder
            document.querySelector(".service-builder-summary")?.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });
        });
    }

    const builder = document.querySelector(".service-builder");

    const categoryToggles = builder.querySelectorAll(
        ".service-builder-category-toggle"
    );

    categoryToggles.forEach((toggle) => {
        toggle.addEventListener("click", () => {
            const content = toggle.nextElementSibling;
            const expanded = toggle.getAttribute("aria-expanded") === "true";

            toggle.setAttribute("aria-expanded", String(!expanded));
            content.hidden = expanded;

            const icon = toggle.querySelector("strong");
            icon.textContent = expanded ? "+" : "−";
        });
    });

    if (builder) {
        const options = builder.querySelectorAll(
            ".service-builder-option input"
        );

        const selectedContainer = builder.querySelector(
            "#service-builder-selected"
        );

        const totalElement = builder.querySelector(
            "#service-builder-total"
        );

        const whatsappButton = builder.querySelector(
            "#service-builder-whatsapp"
        );

        const updateBuilder = () => {
            const selectedServices = Array.from(options)
                .filter((option) => option.checked)
                .map((option) => ({
                    option,
                    name: option.dataset.serviceName,
                    price: Number(option.dataset.servicePrice.replace(/[^\d]/g, "")),
                }));

            const total = selectedServices.reduce(
                (sum, service) => sum + service.price,
                0
            );

            selectedContainer.innerHTML = selectedServices.length
                ? selectedServices
                    .map(
                        (service) => `
                            <span class="selected-service-item">
                                <span class="selected-service-name">${service.name}</span>

                                <span class="selected-service-price">
                                    ₹${service.price.toLocaleString("en-IN")}
                                </span>

                                <button
                                    type="button"
                                    class="builder-remove-service"
                                    data-service-value="${service.option.value}"
                                    aria-label="Remove ${service.name}"
                                >&times;</button>
                            </span>
                        `
                    )
                    .join("")
                : "No services selected yet.";

            totalElement.textContent = `₹${total.toLocaleString("en-IN")}`;

            document.querySelectorAll(".finder-add-package").forEach((button) => {
                const serviceNumber = button.dataset.serviceNumber;

                const matchingOption = Array.from(options).find(
                    (option) => option.value === serviceNumber
                );

                if (!matchingOption) return;

                const isAdded = matchingOption.checked;

                button.textContent = isAdded
                    ? "✓ Added to My Package"
                    : "ADD TO MY PACKAGE";

                button.classList.toggle("added", isAdded);
            });
        };

        selectedContainer.addEventListener("click", (event) => {
                const removeButton = event.target.closest(".builder-remove-service");

                if (!removeButton) return;

                const serviceValue = removeButton.dataset.serviceValue;

                const matchingOption = Array.from(options).find(
                    (option) => option.value === serviceValue
                );

                if (!matchingOption) return;

                // Remove the service from the Package Builder
                matchingOption.checked = false;

                // Trigger the existing Package Builder update logic
                matchingOption.dispatchEvent(
                    new Event("change", { bubbles: true })
                );

                // Reset the corresponding Find Your Service button
                document.querySelectorAll(".finder-add-package").forEach((button) => {
                    if (button.dataset.serviceNumber === serviceValue) {
                        button.textContent = "ADD TO MY PACKAGE";
                        button.classList.remove("added");
                    }
                });
            });

        options.forEach((option) => {
            option.addEventListener("change", updateBuilder);
        });

        whatsappButton.addEventListener("click", () => {
            const selectedServices = Array.from(options)
                .filter((option) => option.checked)
                .map((option) => ({
                    name: option.dataset.serviceName,
                    price: Number(option.dataset.servicePrice.replace(/[^\d]/g, "")),
                }));

            if (!selectedServices.length) {
                alert("Please select at least one service before enquiring.");
                return;
            }

            const total = selectedServices.reduce(
                (sum, service) => sum + service.price,
                0
            );

            const message = [
                `Hi ${site.name},`,
                "",
                "I found your salon through your website and I'm interested in this beauty package:",
                "",
                ...selectedServices.map(
                    (service) =>
                        `• ${service.name} - ₹${service.price.toLocaleString("en-IN")}`
                ),
                "",
                `Package Total: ₹${total.toLocaleString("en-IN")}`,
                "",
                "Could you please share more details?",
                "",
                "Thank you!"
            ].join("\n");

            window.open(
                `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(message)}`,
                "_blank"
            );
        });
    }

    const transformationSliders = document.querySelectorAll(
        ".before-after-slider"
    );

    transformationSliders.forEach((slider) => {
        const before = slider.querySelector(".before-after-before");
        const after = slider.querySelector(".before-after-after");
        const divider = slider.querySelector(".before-after-divider");
        const updatePosition = (clientX) => {
            const rect = slider.getBoundingClientRect();

            let percentage = ((clientX - rect.left) / rect.width) * 100;

            percentage = Math.max(0, Math.min(100, percentage));

            before.style.clipPath = `inset(0 ${100 - percentage}% 0 0)`;
            after.style.clipPath = `inset(0 0 0 ${percentage}%)`;
            divider.style.left = `${percentage}%`;
        };

        slider.addEventListener("pointerdown", (event) => {
            event.preventDefault();

            slider.setPointerCapture(event.pointerId);

            updatePosition(event.clientX);
        });

        slider.addEventListener("pointermove", (event) => {
            if (!slider.hasPointerCapture(event.pointerId)) {
            return;
            }

            event.preventDefault();

            updatePosition(event.clientX);
        });

        slider.addEventListener("pointerup", (event) => {
            if (slider.hasPointerCapture(event.pointerId)) {
            slider.releasePointerCapture(event.pointerId);
            }
        });

        slider.addEventListener("pointercancel", (event) => {
            if (slider.hasPointerCapture(event.pointerId)) {
            slider.releasePointerCapture(event.pointerId);
            }
        });
    });

    // ========================================
    // Lumière — FAQ Accordion
    // ========================================

    document.querySelectorAll("#faq .faq-question").forEach((question) => {
        question.addEventListener("click", () => {
            const answer = question.nextElementSibling;

            if (!answer || !answer.classList.contains("faq-answer")) {
                return;
            }

            const isExpanded = question.getAttribute("aria-expanded") === "true";

            // Close all FAQ items.
            document.querySelectorAll("#faq .faq-question").forEach((otherQuestion) => {
                otherQuestion.setAttribute("aria-expanded", "false");

                const otherAnswer = otherQuestion.nextElementSibling;

                if (otherAnswer && otherAnswer.classList.contains("faq-answer")) {
                    otherAnswer.hidden = true;
                }
            });

            // Open the clicked item if it was previously closed.
            if (!isExpanded) {
                question.setAttribute("aria-expanded", "true");
                answer.hidden = false;
            }
        });
    });
</script>