    }

    /* Subtle scrollbar */
    #custom-service-picker .service-picker-options::-webkit-scrollbar {
        width: 6px;
    }

    #custom-service-picker .service-picker-options::-webkit-scrollbar-thumb {
        border-radius: 10px;
