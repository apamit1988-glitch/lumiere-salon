    :global(.service-picker-option) {
        display: block;
        width: 100%;
        padding: 0.8rem 1rem;
        box-sizing: border-box;

        border: none;
        border-radius: 4px;
        background: transparent;
        color: #514941;

        font-family: inherit;
        font-size: 0.92rem;
        text-align: left;
        cursor: pointer;

        transition:
            background 0.15s ease,
            color 0.15s ease;
    }

    #custom-service-picker
    .service-picker-options
    :global(.service-picker-option:hover) {
        background: #f3ece3;
        color: #211c19;
    }

    #custom-service-picker
    .service-picker-options
    :global(.service-picker-option[aria-selected="true"]) {
        background: #b89b72;
